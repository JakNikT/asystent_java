# Automatyczna normalizacja zakończeń linii
* text=auto

# Wymuś LF dla plików tekstowych
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Pliki binarne - nie normalizuj
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.class binary
*.ttf binary
*.woff binary
*.woff2 binary

# Ignoruj zmiany whitespace w plikach konfiguracyjnych
*.bat text eol=crlf
*.ps1 text eol=crlf