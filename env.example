# Konfiguracja Serwera
PORT=5001

# FireSnow API
FIRESNOW_API_URL=http://localhost:8081
USE_FIRESNOW_API=true

# Logowanie
LOG_LEVEL=info
LOG_DIR=logs

# Baza Danych MySQL
# WAŻNE: Uzupełnij poprawne dane do połączenia z bazą danych
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=TWOJE_HASLO_TUTAJ
DB_NAME=sprzet_narciarski
DB_HISTORY_NAME=history

# Autoryzacja Pracownika (WYMAGANE - serwer nie wystartuje bez tych wartości)
EMPLOYEE_PIN=
# AUTH_SECRET: wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Uwagi:
# - DB_PASSWORD jest WYMAGANY - serwer nie wystartuje bez niego
# - EMPLOYEE_PIN: 4-12 cyfr, różny od 0000 (PIN do logowania pracownika w aplikacji)
# - AUTH_SECRET: minimum 32 znaki, losowy (nie używaj wartości domyślnych)
# - Użyj bezpiecznego hasła do bazy (minimum 12 znaków, wielkie/małe litery, cyfry, znaki specjalne)
# - NIE commituj pliku .env do repozytorium git
# - Skopiuj ten plik do .env i uzupełnij wartości




