{
  "name": "asystent-nart-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "convert-firefnow": "node scripts/convert-firefnow-to-rezerwacja.cjs",
    "server": "tsx server.ts",
    "server:js": "node server.js",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:server": "tsx watch server.ts",
    "dev:all": "concurrently \"cd FireSnowBridge && start-headless.bat\" \"npm run server\" \"npm run dev\" --names \"JAVA,API,WEB\" --prefix-colors \"yellow,blue,green\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.21.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.22",
    "iconv-lite": "^0.7.0",
    "mysql2": "^3.15.3",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-calendar-timeline": "^0.30.0-beta.4",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.4.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^25.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.13",
    "@types/react-calendar-timeline": "^0.28.6",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.7",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "util": "^0.12.5",
    "vite": "^7.1.7",
    "vitest": "^4.0.13"
  }
